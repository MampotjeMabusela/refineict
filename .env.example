PORT=3000
NODE_ENV=development

# Public site origin (CORS + cookies in production)
CORS_ORIGIN=http://localhost:3000

# Session signing secret — generate a long random string for production
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login (plain password for local/dev; prefer ADMIN_PASSWORD_HASH in production)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
# ADMIN_PASSWORD_HASH=

# SMTP (optional — forms still save to SQLite if unset.
# Leave blank locally. Hosts containing "example.com" are ignored.)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Refine ICT <mattheomt@refineict.com>"
# NOTIFY_EMAIL=mattheomt@refineict.com
COMPANY_NAME=Refine ICT

# Theo assistant (Vercel AI Gateway — optional locally; on Vercel OIDC works without a key)
# AI_GATEWAY_API_KEY=
# KAT_MODEL=openai/gpt-4.1-mini
